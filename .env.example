# Copy to .env and change every password. .env is not committed.
DB_PASSWORD=Change-me-2026!
MINIO_USER=amlak
MINIO_PASSWORD=change-me-minio-2026
# MINIO_IMAGE=registry.example.ir/minio:latest
SITE_URL=http://localhost:8080
PHOTOS_URL=http://localhost:9000/amlak
SEED_DEMO=true
# Test mode: shows the OTP code on screen and adds demo admin/user login buttons. Turn off before going live.
DEMO_MODE=true
ADMIN_EMAIL=admin@example.ir
ADMIN_PASSWORD=Change-me-admin-2026
# Kavenegar for real OTP SMS (Log writes the code to the web container's log):
SMS_PROVIDER=Log
SMS_API_KEY=
SMS_TEMPLATE=
SMS_SENDER=
# Telegram bot from @BotFather. Find chat ids in the admin panel: /Admin/Bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Telegram is filtered in Iran: point this at your own relay if the server is inside Iran.
TELEGRAM_API_BASE=https://api.telegram.org
BALE_BOT_TOKEN=
BALE_CHAT_ID=
BALE_ADMIN_CHAT_ID=
