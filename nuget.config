<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="ignoreFailedSources" value="true" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalNuget" value="Nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="LocalNuget">
      <package pattern="AhmadBase.*" />
      <package pattern="Ahmad.Base.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
