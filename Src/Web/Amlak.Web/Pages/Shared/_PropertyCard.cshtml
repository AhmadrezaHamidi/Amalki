@model Property
<article class="card">
    <div class="ph">
        @if (Model.Photos.FirstOrDefault() is { } p) { <img src="@p.Url" alt="@p.Alt" loading="lazy" width="640" height="480" /> }
        <span class="badge @(Model.Deal == DealType.Rent ? "rent" : "")">@(Model.Deal == DealType.Sale ? "فروش" : "اجاره")</span>
    </div>
    <div class="b">
        <h3>@Model.Title</h3>
        <div class="loc">@Model.City، @Model.District</div>
        <div class="meta"><span>@Fa.Digits(Model.AreaM2.ToString()) متر</span>@if (Model.Bedrooms is { } r) {<span>@Fa.Digits(r.ToString()) خواب</span>}</div>
        <div class="price">
            @if (Model.Deal == DealType.Sale) { <text>@Fa.Money(Model.Price) <small>تومان</small></text> }
            else { <text>@Fa.Money(Model.Deposit) رهن <small>+ @Fa.Money(Model.MonthlyRent) اجاره</small></text> }
        </div>
    </div>
    <a class="cover" asp-page="/Properties/Details" asp-route-slug="@Model.Slug" aria-label="@Model.Title"></a>
</article>
