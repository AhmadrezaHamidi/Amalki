@page
@model Amlak.Web.Pages.Admin.IndexModel
@{ ViewData["Title"] = "مدیریت آگهی‌ها"; ViewData["Robots"] = "noindex,nofollow"; }
<div class="wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin:24px 0;gap:12px;flex-wrap:wrap">
        <h1>مدیریت آگهی‌ها</h1>
        <div style="display:flex;gap:10px">
            <a class="btn" asp-page="Edit">+ آگهی جدید</a>
            <form method="post" asp-page="/Account/Logout"><button class="btn ghost">خروج</button></form>
        </div>
    </div>
    <div class="tablewrap">
        <table class="table">
            <thead><tr><th>عنوان</th><th>معامله</th><th>شهر</th><th>وضعیت</th><th>عملیات</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td><a asp-page="Edit" asp-route-id="@p.Id">@p.Title</a></td>
                    <td>@(p.Deal == DealType.Sale ? "فروش" : "اجاره")</td>
                    <td>@p.City</td>
                    <td>@(p.Status switch { ListingStatus.Published => "منتشرشده", ListingStatus.Closed => "بسته‌شده", _ => "پیش‌نویس" })</td>
                    <td class="actions">
                        <form method="post" asp-page-handler="TogglePublish" asp-route-id="@p.Id"><button class="btn sm">@(p.Status == ListingStatus.Published ? "لغو انتشار" : "انتشار")</button></form>
                        <a class="btn sm ghost" asp-page="Edit" asp-route-id="@p.Id">ویرایش</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" onsubmit="return confirm('این آگهی برای همیشه حذف شود؟')"><button class="btn sm danger">حذف</button></form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Items.Count == 0) { <p>آگهی‌ای ثبت نشده است.</p> }
</div>
