<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Amlak.Estate.ServiceHost</AssemblyName>
    <RootNamespace>Amlak.ServiceHost</RootNamespace>
    <UserSecretsId>ed9c4b02-188d-4c71-88d8-7cf01d6084e4</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Amlak.xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\Amlak.Application.Contract\Amlak.Application.Contract.csproj" />
    <ProjectReference Include="..\..\Application\Amlak.Application.Query.Contract\Amlak.Application.Query.Contract.csproj" />
    <ProjectReference Include="..\..\Application\Amlak.Application\Amlak.Application.csproj" />
    <ProjectReference Include="..\..\Application\Amlak.Application.Query\Amlak.Application.Query.csproj" />
    <ProjectReference Include="..\..\Application\Amlak.Application.Validators\Amlak.Application.Validators.csproj" />
    <ProjectReference Include="..\..\Application\Amlak.Event.Handler\Amlak.Event.Handler.csproj" />
    <ProjectReference Include="..\..\Domain\Amlak.Domain\Amlak.Domain.csproj" />
    <ProjectReference Include="..\..\Domain\Amlak.Event\Amlak.Event.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Amlak.Config\Amlak.Config.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Amlak.Persistence.EF\Amlak.Persistence.EF.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Amlak.Read.Dapper\Amlak.Read.Dapper.csproj" />
    <ProjectReference Include="..\..\Rest\Amlak.Rest\Amlak.Rest.csproj" />
    <ProjectReference Include="..\Amlak.Option\Amlak.Option.csproj" />
  </ItemGroup>

</Project>
