{
  "ApplicationName": "Amlak - Real Estate API",
  "CompanyName": "Amlak",
  "ContextName": "Estate",
  "UseFakeServices": false,

  "Platform": {
    "//": "شماره‌هایی که با ورود، نقش مدیر می‌گیرند و پیامک درخواست تماس را دریافت می‌کنند. نقش هرگز از کلاینت گرفته نمی‌شود.",
    "AdminPhones": [ "09120000000" ]
  },

  "Site": {
    "//": "آدرس عمومی سایت — برای لینک داخل پست کانال‌ها",
    "BaseUrl": "https://example.ir",
    "Name": "آشیانه"
  },

  "Storage": {
    "PhotoPath": "storage/photos",
    "PhotoUrlPrefix": "/api/v1/Photos/"
  },

  "Telegram": {
    "//": "توکن و شناسه فقط از user-secrets یا متغیر محیطی. ApiBase برای واسط/پروکسی (تلگرام در ایران فیلتر است).",
    "BotToken": "",
    "ChatId": "",
    "ApiBase": ""
  },

  "Bale": {
    "BotToken": "",
    "ChatId": "",
    "ApiBase": ""
  },

  "ConnectionStrings": {
    "CommandConnection": "Server=localhost\\SQLEXPRESS;Database=AmlakApi;Trusted_Connection=True;TrustServerCertificate=True;",
    "QueryConnection": "Server=localhost\\SQLEXPRESS;Database=AmlakApi;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "JWTOptions": {
    "ValidAudience": "AmlakClient",
    "ValidIssuer": "Amlak",
    "Secret": "CHANGE_ME_USE_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "TokenExpireMinutes": 60,
    "RefreshExpireMinutes": 43200
  },

  "Sms": {
    "ApiKey": "CHANGE_ME_SMS_API_KEY",
    "LineNumber": 30005000,
    "BaseUrl": "https://api.sms.ir/v1/send/bulk",
    "OtpTemplate": "کد ورود به پنل املاک: {0}\nاین کد تا ۵ دقیقه معتبر است.",
    "Resilience": {
      "MaxRetryAttempts": 2,
      "RetryDelay": "00:00:01",
      "MinimumThroughput": 3,
      "FailureRatio": 0.5,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:01:00",
      "Timeout": "00:00:10"
    }
  },

  "Swagger": {
    "Title": "Amlak API",
    "Version": "v1",
    "Description": "سامانهٔ آگهی املاک — سایت عمومی، پنل مدیریت، انتشار در تلگرام و بله"
  },

  "NHilo": {
    "ConnectionStringId": "CommandConnection",
    "ProviderName": "Microsoft.Data.SqlClient",
    "CreateHiLoStructureIfNotExists": true,
    "DefaultMaxLo": 1,
    "TableName": "HiLoIds",
    "NextHiColumnName": "NextHi",
    "EntityColumnName": "Entity",
    "StorageType": "1",
    "ObjectPrefix": "",
    "Entities": []
  },

  "Redis": {
    "ConnectionString": "localhost:6379"
  },

  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  }
}
