<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f6dc229b-5d07-4ac4-8121-15b6e6cd0bbd</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Amlak.Domain" />
    <Using Include="Amlak.Application" />
    <Using Include="Amlak.Application.Abstractions" />
    <InternalsVisibleTo Include="Amlak.Tests" />
  </ItemGroup>

  <!-- Dependencies point inwards: Web (UI, EF Core) and Infrastructure (files, SMS) -> Application (use cases, ports) -> Domain. -->
  <ItemGroup>
    <ProjectReference Include="..\Amlak.Domain\Amlak.Domain.csproj" />
    <ProjectReference Include="..\Amlak.Application\Amlak.Application.csproj" />
    <ProjectReference Include="..\Amlak.Infrastructure\Amlak.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

</Project>
