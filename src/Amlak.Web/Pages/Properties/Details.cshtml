@page "/ملک/{slug}"
@model Amlak.Web.Pages.Properties.DetailsModel
@using System.Globalization
@using Amlak.Web.Services.Seo
@inject IConfiguration Cfg
@{
    var p = Model.Item;
    var rent = p.Deal == DealType.Rent;
    var site = (Cfg["Site:BaseUrl"] ?? $"{Model.Request.Scheme}://{Model.Request.Host}").TrimEnd('/');
    var url = SeoFiles.PropertyUrl(site, p);
    var shortTerm = p.Deal == DealType.ShortTerm;
    var dealLabel = rent ? "اجارهٔ" : shortTerm ? "اجارهٔ کوتاه‌مدت" : "فروش";
    ViewData["Title"] = $"{p.Title} | {dealLabel} در {p.District} {p.City}";
    var hidden = !p.ShowsPrice;
    var offer = new Dictionary<string, object?> { ["@type"] = "Offer", ["priceCurrency"] = "IRT", ["availability"] = "https://schema.org/InStock" };
    if (!hidden) offer["price"] = !rent ? p.Price : p.MonthlyRent; // a "توافقی" listing publishes no amount
    ViewData["Description"] = $"{p.Title}، {Fa.Digits(p.AreaM2.ToString())} متر در {p.District}، {p.City}. " + (hidden ? "قیمت توافقی" : shortTerm ? "هر شب " + Fa.Money(p.Price) + " تومان" : !rent ? "قیمت " + Fa.Money(p.Price) + " تومان" : "رهن " + Fa.Money(p.Deposit) + " و اجارهٔ ماهانه " + Fa.Money(p.MonthlyRent) + " تومان");
    ViewData["Canonical"] = url;
    ViewData["BodyClass"] = "has-mobile-cta";
    // Crawlers and link previews need absolute image URLs; MinIO URLs already are.
    string Abs(string u) => u.StartsWith('/') ? site + u : u;
    if (p.Photos.FirstOrDefault() is { } first) ViewData["OgImage"] = Abs(first.Url);
    var ld = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "RealEstateListing",
        ["name"] = p.Title,
        ["description"] = p.Description,
        ["url"] = url,
        ["datePosted"] = p.PublishedAtUtc?.ToString("yyyy-MM-dd"),
        ["image"] = p.Photos.Select(x => Abs(x.Url)).ToArray(),
        ["address"] = new Dictionary<string, string> { ["@type"] = "PostalAddress", ["addressLocality"] = p.City, ["addressRegion"] = p.District, ["addressCountry"] = "IR" },
        ["floorSize"] = new Dictionary<string, object> { ["@type"] = "QuantitativeValue", ["value"] = p.AreaM2, ["unitCode"] = "MTK" },
        ["offers"] = offer
    };
    var ldJson = JsonLd.Serialize(ld);
    // خانه / تهران / خرید آپارتمان / سعادت‌آباد / آگهی, each a landing page.
    var cat = Taxonomy.For(p.Deal, p.Kind)!;
    var crumbs = new (string Name, string Path)[]
    {
        (p.City, Taxonomy.EncodedPath(p.City, null)),
        (cat.Name, Taxonomy.EncodedPath(p.City, cat)),
        (p.District, Taxonomy.EncodedPath(p.City, cat, p.District)),
    };
    var crumbJson = JsonLd.Serialize(JsonLd.Breadcrumbs(
        [("خانه", site + "/"), .. crumbs.Select(c => (c.Name, site + c.Path)), (p.Title, SeoFiles.PropertyUrl(site, p))]));
    var phone = Cfg["Site:Phone"];
    var photos = p.Photos;
    var shown = photos.Take(5).ToList();
    var perMeter = PriceText.PerSquareMeter(p);
    string Inv(double v) => v.ToString(CultureInfo.InvariantCulture);
}
@section Head {
    <script type="application/ld+json">@Html.Raw(ldJson)</script>
    <script type="application/ld+json">@Html.Raw(crumbJson)</script>
}
<div class="wrap page-pad detail-page">
    <nav class="crumbs" aria-label="مسیر"><a href="/">خانه</a>@foreach (var c in crumbs) { <text> / </text><a href="@c.Path">@c.Name</a> }</nav>

    <div class="detail-top">
    <div class="detail-head">
        <div>
            <div class="tags"><span class="badge @(rent ? "rent" : "")">@Labels.Deal(p.Deal)</span><span class="badge soft">@Labels.Kind(p.Kind)</span></div>
            <h1>@p.Title</h1>
            <span class="loc">@Icons.Get("pin", 18) @p.District، @p.City · کد آگهی @Fa.Digits(p.Id.ToString())</span>
            @if (p.PublishedAtUtc is { } pub) { <span class="posted"><time datetime="@pub.ToString("o")">@Fa.Ago(pub)</time> در @p.District</span> }
        </div>
        <div class="row-actions">
            <button class="btn quiet" type="button" data-fav="@p.Id" aria-pressed="false" data-fav-label>@Icons.Get("heart", 18)<span>نشان کردن</span></button>
            <button class="btn quiet" type="button" data-share data-title="@p.Title" data-url="@url">@Icons.Get("share", 18)<span>اشتراک‌گذاری</span></button>
        </div>
    </div>

    @if (shown.Count == 0)
    {
        <div class="gallery-empty">@Icons.Get("photo", 56)</div>
    }
    else
    {
        <div class="gallery n@(Math.Min(shown.Count, 5))" data-gallery>
            @for (var i = 0; i < shown.Count; i++)
            {
                var f = shown[i];
                <button type="button" class="@(i == 0 ? "main" : "")" data-index="@i" aria-label="بزرگ‌نمایی عکس @Fa.Digits((i + 1).ToString())">
                    @PhotoVariants.Img(f, i == 0 || shown.Count <= 2 ? (shown.Count == 1 ? "(max-width: 900px) 88vw, 1200px" : "(max-width: 900px) 88vw, 600px") : "(max-width: 900px) 88vw, 300px", 1200, 900, eager: i == 0)
                    @if (i == shown.Count - 1 && photos.Count > 1) { <span class="all">نمایش همهٔ @Fa.Digits(photos.Count.ToString()) عکس</span> }
                </button>
            }
        </div>
        <dialog class="lightbox" data-lightbox aria-label="عکس‌های آگهی">
            <div class="lb-bar">
                <span data-lb-count aria-live="polite"></span>
                <button class="lb-btn" type="button" data-lb-close aria-label="بستن">@Icons.Get("close")</button>
            </div>
            <div class="lb-stage">
                <button class="lb-btn prev" type="button" data-lb-prev aria-label="عکس قبلی">@Icons.Get("chev-right")</button>
                <img data-lb-img alt="" />
                <button class="lb-btn next" type="button" data-lb-next aria-label="عکس بعدی">@Icons.Get("chev-left")</button>
            </div>
            <script type="application/json" data-lb-photos>@Html.Raw(JsonLd.Serialize(photos.Select(x => new { src = PhotoVariants.Largest(x), alt = x.Alt })))</script>
        </dialog>
    }
    </div>

    <div class="detail-layout">
        <div class="detail-main">
            <section aria-labelledby="facts-title">
                <h2 id="facts-title" class="sr-only">مشخصات</h2>
                <ul class="keyfacts">
                    <li><span>متراژ</span><strong>@Fa.Digits(p.AreaM2.ToString())</strong></li>
                    <li><span>اتاق</span><strong>@(p.Bedrooms is { } b ? (b == 0 ? "ندارد" : Fa.Digits(b.ToString())) : "—")</strong></li>
                    <li><span>ساخت</span><strong>@(p.YearBuilt is { } y ? Fa.Digits(y.ToString()) : "—")</strong></li>
                    <li><span>طبقه</span><strong>@(p.Floor is { } fl ? (fl == 0 ? "همکف" : Fa.Digits(fl.ToString())) : "—")</strong></li>
                </ul>
                <dl class="rows">
                    @if (hidden)
                    {
                        <div><dt>قیمت</dt><dd>توافقی</dd></div>
                    }
                    else if (rent)
                    {
                        <div><dt>ودیعه (رهن)</dt><dd>@Fa.Money(p.Deposit) تومان</dd></div>
                        <div><dt>اجارهٔ ماهانه</dt><dd>@Fa.Money(p.MonthlyRent) تومان</dd></div>
                        <div><dt>رهن و اجاره</dt><dd>@(p.Convertible ? "قابل تبدیل" : "غیرقابل تبدیل")</dd></div>
                    }
                    else
                    {
                        <div><dt>@(shortTerm ? "اجارهٔ هر شب" : "قیمت کل")</dt><dd>@Fa.Money(p.Price) تومان</dd></div>
                        @if (perMeter is { } ppm) { <div><dt>قیمت هر متر</dt><dd>@Fa.Money(ppm) تومان</dd></div> }
                    }
                    <div><dt>نوع ملک</dt><dd>@Labels.Kind(p.Kind)</dd></div>
                    @if (p.Parking is { } pk) { <div><dt>پارکینگ</dt><dd>@(pk == 0 ? "ندارد" : Fa.Digits(pk.ToString()) + " واحد")</dd></div> }
                    @if (p.Deed is { } deed) { <div><dt>سند</dt><dd>@Labels.Deed(deed)</dd></div> }
                </dl>
                @if (p.HasElevator is not null || p.Parking is not null || p.HasStorage is not null || p.HasBalcony is not null)
                {
                    // Divar's three-up "has / has not" row, plus balcony.
                    var amenities = new (string Name, bool? Has)[] { ("آسانسور", p.HasElevator), ("پارکینگ", p.Parking is null ? null : p.Parking > 0), ("انباری", p.HasStorage), ("بالکن", p.HasBalcony) };
                    <h2 class="sub">امکانات</h2>
                    <ul class="amenities" aria-label="امکانات">
                        @foreach (var (name, has) in amenities.Where(x => x.Has is not null))
                        {
                            <li class="@(has == true ? "" : "no")">@Icons.Get(has == true ? "check" : "close", 18)@name<span class="sr-only">@(has == true ? "دارد" : "ندارد")</span></li>
                        }
                    </ul>
                }
            </section>

            <p class="safety">@Icons.Get("warn", 20)<span>پیش از دیدن ملک و سند، هیچ مبلغی به‌عنوان بیعانه واریز نکنید. قرارداد را با حضور مشاور آشیانه ببندید.</span></p>

            <section aria-labelledby="desc-title">
                <h2 id="desc-title">توضیحات</h2>
                <p class="desc">@p.Description</p>
            </section>

            @if (p.Latitude is { } lat && p.Longitude is { } lng)
            {
                var d = 0.006;
                <section aria-labelledby="map-title">
                    <h2 id="map-title">موقعیت روی نقشه</h2>
                    <div class="map">
                        <iframe title="نقشهٔ موقعیت @p.Title" loading="lazy" referrerpolicy="no-referrer"
                                src="https://www.openstreetmap.org/export/embed.html?bbox=@Inv(lng - d)%2C@Inv(lat - d)%2C@Inv(lng + d)%2C@Inv(lat + d)&layer=mapnik&marker=@Inv(lat)%2C@Inv(lng)"></iframe>
                    </div>
                    <p class="hint" style="margin-top:6px">موقعیت تقریبی است؛ نشانی دقیق هنگام هماهنگی بازدید اعلام می‌شود.</p>
                </section>
            }

            @if (Model.Similar.Count > 0)
            {
                <section aria-labelledby="similar-title">
                    <h2 id="similar-title">آگهی‌های مشابه در @p.City</h2>
                    <p><a href="@Taxonomy.EncodedPath(p.City, cat, p.District)">همهٔ آگهی‌های @cat.Name در @p.District</a></p>
                    <div class="listings">@foreach (var s in Model.Similar) { <partial name="_PropertyCard" model="s" /> }</div>
                </section>
            }
        </div>

        <aside class="panel" id="contact" aria-labelledby="price-title">
            <span class="hint" id="price-title">@(hidden ? "قیمت" : rent ? "رهن" : shortTerm ? "اجارهٔ هر شب" : "قیمت کل")</span>
            @if (hidden)
            {
                <strong class="big">توافقی</strong>
            }
            else if (!rent)
            {
                <strong class="big">@Fa.Money(p.Price) <small>تومان</small></strong>
                @if (perMeter is { } pm) { <span class="hint">هر متر حدود @Fa.Money(pm) تومان</span> }
            }
            else
            {
                <strong class="big rent">@Fa.Money(p.Deposit) <small>تومان</small></strong>
                <span>اجارهٔ ماهانه: <strong>@Fa.Money(p.MonthlyRent)</strong> تومان</span>
            }
            <hr />
            <strong style="font-size:1.05rem">درخواست تماس و بازدید</strong>
            @if (Model.Sent)
            {
                <div class="alert ok" role="status">درخواست شما ثبت شد. مشاور به‌زودی با شما تماس می‌گیرد.</div>
            }
            else
            {
                @* This page is output-cached, so the per-visitor antiforgery token is fetched by site.js on submit. *@
                <form method="post" action="/تماس" class="js-only" data-csrf>
                    <input type="hidden" name="Input.PropertyId" value="@p.Id" />
                    <label class="field">نام<input name="Input.Name" required maxlength="80" autocomplete="name" /></label>
                    <label class="field">شمارهٔ موبایل<input name="Input.Phone" required inputmode="tel" autocomplete="tel" dir="ltr" placeholder="09xxxxxxxxx" style="text-align:right" /></label>
                    <label class="field">پیام (اختیاری)<textarea name="Input.Message" rows="2" maxlength="1000" placeholder="مثلاً زمان مناسب برای بازدید"></textarea></label>
                    <label class="hp" aria-hidden="true">وب‌سایت<input name="Input.Website" tabindex="-1" autocomplete="off" /></label>
                    <button class="btn lg block">ثبت درخواست تماس</button>
                    <span class="hint">شماره‌تان فقط برای هماهنگی همین ملک استفاده می‌شود.</span>
                </form>
                <a class="btn lg block no-js-only" href="/تماس?propertyId=@p.Id">ثبت درخواست تماس</a>
            }
            @if (!string.IsNullOrWhiteSpace(phone))
            {
                <a class="btn ghost lg block" href="tel:@Fa.Latin(phone).Replace(" ", "")">@Icons.Get("phone", 18) تماس مستقیم: <bdi dir="ltr">@phone</bdi></a>
            }
        </aside>
    </div>
</div>

<div class="mobile-cta">
    <div class="p"><small>@(hidden ? "قیمت" : rent ? "رهن" : shortTerm ? "هر شب" : "قیمت")</small><strong>@(hidden ? "توافقی" : Fa.Money(rent ? p.Deposit : p.Price))</strong></div>
    @if (!string.IsNullOrWhiteSpace(phone)) { <a class="btn ghost icon" href="tel:@Fa.Latin(phone).Replace(" ", "")" aria-label="تماس تلفنی">@Icons.Get("phone")</a> }
    <a class="btn" href="#contact">درخواست بازدید</a>
</div>
