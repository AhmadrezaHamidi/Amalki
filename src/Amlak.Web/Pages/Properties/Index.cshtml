@page "/املاک/{citySlug?}/{categorySlug?}/{districtSlug?}"
@model Amlak.Web.Pages.Properties.IndexModel
@using Amlak.Web.Pages.Properties
@using Amlak.Web.Services.Seo
@inject IConfiguration Cfg
@{
    var site = (Cfg["Site:BaseUrl"] ?? $"{Model.Request.Scheme}://{Model.Request.Host}").TrimEnd('/');
    var cat = Model.Category;
    ViewData["Title"] = Model.Heading;
    ViewData["Description"] = $"{Model.Heading}: {Fa.Digits(Model.Total.ToString())} آگهی بررسی‌شده با عکس واقعی و قیمت شفاف"
        + (Model.AvgPricePerM2 is { } avg ? $"، میانگین هر متر {Fa.Money(avg)} تومان." : ".");
    // Each landing page is its own canonical; filtered and paged variants point to it.
    ViewData["Canonical"] = site + Taxonomy.EncodedPath(Model.City, cat, Model.District);
    if (Model.UnknownPlace || Model.Total == 0) ViewData["Robots"] = "noindex,follow";
    var rent = Model.Deal == DealType.Rent;
    string[] bedLabels = ["همه", "۱+", "۲+", "۳+", "۴+"];
    // Breadcrumb: خانه / تهران / خرید آپارتمان / سعادت‌آباد
    var crumbs = new List<(string Name, string Url)> { ("خانه", site + "/") };
    if (Model.City is not null) crumbs.Add((Model.City, site + Taxonomy.EncodedPath(Model.City, null)));
    if (cat is not null) crumbs.Add((cat.Name, site + Taxonomy.EncodedPath(Model.City, cat)));
    if (Model.District is not null) crumbs.Add((Model.District, site + Taxonomy.EncodedPath(Model.City, cat, Model.District)));
    if (crumbs.Count == 1) crumbs.Add(("آگهی‌ها", site + Taxonomy.EncodedPath(null, null)));
    var dealCats = Taxonomy.All.Where(c => c.Deal == (Model.Deal ?? DealType.Sale)).ToList();
}
@section Head {
    <script type="application/ld+json">@Html.Raw(JsonLd.Serialize(JsonLd.Breadcrumbs(crumbs.ToArray())))</script>
}
<div class="wrap page-pad">
    <nav class="crumbs" aria-label="مسیر">
        @for (var i = 0; i < crumbs.Count; i++)
        {
            if (i > 0) { <text> / </text> }
            if (i == crumbs.Count - 1) { <span aria-current="page">@crumbs[i].Name</span> }
            else { <a href="@crumbs[i].Url.Substring(site.Length)">@crumbs[i].Name</a> }
        }
    </nav>
    <div class="list-head">
        <div>
            <h1>@Model.Heading</h1>
            <p>@(Model.Total == 0 ? "آگهی‌ای پیدا نشد" : Fa.Digits(Model.Total.ToString()) + " آگهی پیدا شد")
                @if (Model.AvgPricePerM2 is { } ppm) { <span class="hint"> · میانگین قیمت هر متر @Fa.Money(ppm) تومان</span> }
            </p>
        </div>
        <div class="row-actions">
            <button class="btn quiet filter-toggle" type="button" aria-expanded="false" aria-controls="filters" data-filter-toggle>@Icons.Get("filter") فیلترها</button>
            <form method="get" class="sort" data-autosubmit>
                @foreach (var (k, v) in Model.QueryFilters())
                {
                    if (k is not ("sort" or "p") && v is not null && v.ToString() != "") { <input type="hidden" name="@k" value="@v" /> }
                }
                <label for="sort">مرتب‌سازی</label>
                <select id="sort" name="sort" class="btn quiet" style="font-weight:500">
                    <option value="Newest" selected="@(Model.Sort == SortOrder.Newest)">جدیدترین</option>
                    <option value="Cheapest" selected="@(Model.Sort == SortOrder.Cheapest)">ارزان‌ترین</option>
                    <option value="Priciest" selected="@(Model.Sort == SortOrder.Priciest)">گران‌ترین</option>
                    <option value="Largest" selected="@(Model.Sort == SortOrder.Largest)">بزرگ‌ترین متراژ</option>
                </select>
                <noscript><button class="btn sm">اعمال</button></noscript>
            </form>
        </div>
    </div>

    <nav class="cat-links" aria-label="دسته‌بندی‌ها">
        @foreach (var c in dealCats)
        {
            <a class="chip @(c == cat ? "on" : "")" href="@Model.LinkTo(Model.City, c, c.Kind == Model.Kind ? Model.District : null)" aria-current="@(c == cat ? "page" : null)">@(c.Kind is { } ck ? Labels.Kind(ck) : "همه")</a>
        }
    </nav>

<div class="list-layout">
        <form method="get" class="filters" id="filters" aria-label="فیلتر آگهی‌ها">
            <strong>فیلترها</strong>
            <fieldset class="seg" style="border:0;margin:0">
                <legend class="sr-only">نوع معامله</legend>
                <label><input type="radio" name="deal" value="" checked="@(Model.Deal is null)" /><span>همه</span></label>
                <label><input type="radio" name="deal" value="Sale" checked="@(Model.Deal == DealType.Sale)" /><span>خرید</span></label>
                <label><input type="radio" name="deal" value="Rent" checked="@(Model.Deal == DealType.Rent)" /><span>اجاره</span></label>
            </fieldset>
            <label class="field">شهر<input name="city" value="@Model.City" placeholder="مثلاً تهران" list="city-list" /></label>
            <datalist id="city-list">@foreach (var c in Model.Cities) { <option value="@c.Name"></option> }</datalist>
            @if (Model.Districts.Count > 0)
            {
                <label class="field">محله
                    <select name="district">
                        <option value="">همهٔ محله‌ها</option>
                        @foreach (var d in Model.Districts) { <option value="@d.Name" selected="@(d.Name == Model.District)">@d.Name</option> }
                    </select>
                </label>
            }
            <label class="field">نوع ملک
                <select name="kind">
                    <option value="">همهٔ انواع</option>
                    @foreach (var k in Enum.GetValues<PropertyKind>()) { <option value="@k" selected="@(Model.Kind == k)">@Labels.Kind(k)</option> }
                </select>
            </label>
            <fieldset style="border:0;margin:0;padding:0">
                <legend class="field" style="margin-bottom:6px">تعداد خواب</legend>
                <div class="seg beds">
                    @for (var i = 0; i < bedLabels.Length; i++)
                    {
                        <label><input type="radio" name="beds" value="@(i == 0 ? "" : i.ToString())" checked="@((Model.Beds ?? 0) == i)" /><span>@bedLabels[i]</span></label>
                    }
                </div>
            </fieldset>
            <div class="field-pair">
                <label class="field">متراژ از<input name="minArea" value="@Model.MinArea" inputmode="numeric" placeholder="مثلاً ۸۰" /></label>
                <label class="field">تا<input name="maxArea" value="@Model.MaxArea" inputmode="numeric" placeholder="متر" /></label>
            </div>
            <div class="field-pair">
                <label class="field">@(rent ? "رهن از" : "قیمت از")<input name="minPrice" value="@Model.MinPrice" inputmode="numeric" placeholder="تومان" data-money /></label>
                <label class="field">تا<input name="maxPrice" value="@Model.MaxPrice" inputmode="numeric" placeholder="تومان" data-money /></label>
            </div>
            <p class="hint" data-money-hint aria-live="polite"></p>
            @if (rent)
            {
                <label class="field">سقف اجارهٔ ماهانه<input name="maxRent" value="@Model.MaxRent" inputmode="numeric" placeholder="تومان" data-money /></label>
            }
            <label class="field">سن بنا
                <select name="age">
                    <option value="">فرقی نمی‌کند</option>
                    @foreach (var a in new[] { 0, 5, 10, 15, 20 }) { <option value="@a" selected="@(Model.Age == a)">@(a == 0 ? "نوساز" : "تا " + Fa.Digits(a.ToString()) + " سال")</option> }
                </select>
            </label>
            <fieldset class="checks">
                <legend class="field">امکانات</legend>
                <label><input type="checkbox" name="elevator" value="true" checked="@Model.Elevator" /> آسانسور</label>
                <label><input type="checkbox" name="parking" value="true" checked="@Model.Parking" /> پارکینگ</label>
                <label><input type="checkbox" name="storage" value="true" checked="@Model.Storage" /> انباری</label>
                <label><input type="checkbox" name="photo" value="true" checked="@Model.Photo" /> فقط عکس‌دار</label>
                @if (rent) { <label><input type="checkbox" name="convertible" value="true" checked="@Model.Convertible" /> رهن و اجاره قابل تبدیل</label> }
            </fieldset>
            @if (Model.Sort != SortOrder.Newest) { <input type="hidden" name="sort" value="@Model.Sort" /> }
            <button class="btn block">اعمال فیلتر</button>
            @if (Model.HasFilters) { <a href="@Taxonomy.EncodedPath(Model.City, cat, Model.District)" style="text-align:center;font-size:.9rem">پاک کردن فیلترها</a> }
        </form>

        <div class="list-main">
            @if (Model.HasFilters)
            {
                <div class="chips" aria-label="فیلترهای فعال">
                    @if (Model.Kind is { } fk && Model.Deal is null) { <span class="chip">@Labels.Kind(fk) <a href="@Model.Link(("kind", null))" aria-label="حذف فیلتر نوع ملک">×</a></span> }
                    @if (Model.Beds is { } fb and > 0) { <span class="chip">@Fa.Digits(fb.ToString())+ خواب <a href="@Model.Link(("beds", null))" aria-label="حذف فیلتر خواب">×</a></span> }
                    @if (Model.MinAreaValue is { } fa) { <span class="chip">از @Fa.Digits(fa.ToString()) متر <a href="@Model.Link(("minArea", null))" aria-label="حذف فیلتر حداقل متراژ">×</a></span> }
                    @if (Model.MaxAreaValue is { } fa2) { <span class="chip">تا @Fa.Digits(fa2.ToString()) متر <a href="@Model.Link(("maxArea", null))" aria-label="حذف فیلتر حداکثر متراژ">×</a></span> }
                    @if (Model.MinPriceValue is { } fp1) { <span class="chip">از @Fa.Money(fp1) <a href="@Model.Link(("minPrice", null))" aria-label="حذف فیلتر حداقل قیمت">×</a></span> }
                    @if (Model.MaxPriceValue is { } fp) { <span class="chip">تا @Fa.Money(fp) <a href="@Model.Link(("maxPrice", null))" aria-label="حذف فیلتر قیمت">×</a></span> }
                    @if (Model.MaxRentValue is { } fr) { <span class="chip">اجاره تا @Fa.Money(fr) <a href="@Model.Link(("maxRent", null))" aria-label="حذف فیلتر اجاره">×</a></span> }
                    @if (Model.Age is { } fage) { <span class="chip">@(fage == 0 ? "نوساز" : "تا " + Fa.Digits(fage.ToString()) + " سال ساخت") <a href="@Model.Link(("age", null))" aria-label="حذف فیلتر سن بنا">×</a></span> }
                    @if (Model.Elevator) { <span class="chip">آسانسور <a href="@Model.Link(("elevator", null))" aria-label="حذف فیلتر آسانسور">×</a></span> }
                    @if (Model.Parking) { <span class="chip">پارکینگ <a href="@Model.Link(("parking", null))" aria-label="حذف فیلتر پارکینگ">×</a></span> }
                    @if (Model.Storage) { <span class="chip">انباری <a href="@Model.Link(("storage", null))" aria-label="حذف فیلتر انباری">×</a></span> }
                    @if (Model.Photo) { <span class="chip">عکس‌دار <a href="@Model.Link(("photo", null))" aria-label="حذف فیلتر عکس‌دار">×</a></span> }
                    @if (Model.Convertible) { <span class="chip">قابل تبدیل <a href="@Model.Link(("convertible", null))" aria-label="حذف فیلتر قابل تبدیل">×</a></span> }
                </div>
            }
            @if (Model.Items.Count == 0)
            {
                <div class="empty-state">
                    @Icons.Get("search", 48)
                    <h2>آگهی‌ای با این فیلترها پیدا نشد</h2>
                    <p>فیلترها را کمتر کنید، یا مشخصات ملک موردنظرتان را بفرستید تا وقتی پیدا شد خبرتان کنیم.</p>
                    <div class="row-actions" style="justify-content:center">
                        <a class="btn ghost" href="@Taxonomy.EncodedPath(null, null)">همهٔ آگهی‌ها</a>
                        <a class="btn" href="/تماس">سفارش ملک</a>
                    </div>
                </div>
            }
            else
            {
                <div class="grid cols-3">@foreach (var p in Model.Items) { <partial name="_PropertyCard" model="p" /> }</div>
            }
            @if (Model.Pages > 1)
            {
                <nav class="pager" aria-label="صفحه‌بندی">
                    @if (Model.P > 1) { <a href="@Model.Link(("p", Model.P - 1))" rel="prev">قبلی</a> }
                    @for (var i = 1; i <= Model.Pages; i++)
                    {
                        if (i == Model.P) { <span aria-current="page">@Fa.Digits(i.ToString())</span> }
                        else if (i == 1 || i == Model.Pages || Math.Abs(i - Model.P) <= 2) { <a href="@Model.Link(("p", i))">@Fa.Digits(i.ToString())</a> }
                        else if (Math.Abs(i - Model.P) == 3) { <span aria-hidden="true">…</span> }
                    }
                    @if (Model.P < Model.Pages) { <a href="@Model.Link(("p", Model.P + 1))" rel="next">بعدی</a> }
                </nav>
            }
        </div>
    </div>
    @if (Model.Districts.Count > 0 && cat is not null)
    {
        <section class="place-links" aria-labelledby="districts-title">
            <h2 id="districts-title">@cat.Name در محله‌های @Model.City</h2>
            <ul>@foreach (var d in Model.Districts) { <li><a href="@Taxonomy.EncodedPath(Model.City, cat, d.Name)" aria-current="@(d.Name == Model.District ? "page" : null)">@cat.Name در @d.Name <small>(@Fa.Digits(d.Count.ToString()))</small></a></li> }</ul>
        </section>
    }
    @if (Model.Cities.Any(c => c.Name != Model.City))
    {
        <section class="place-links" aria-labelledby="cities-title">
            <h2 id="cities-title">@(cat?.Name ?? "آگهی ملک") در شهرهای دیگر</h2>
            <ul>@foreach (var c in Model.Cities.Where(c => c.Name != Model.City)) { <li><a href="@Taxonomy.EncodedPath(c.Name, cat)">@(cat?.Name ?? "املاک") @c.Name</a></li> }</ul>
        </section>
    }
</div>
