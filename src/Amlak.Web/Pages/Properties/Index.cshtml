@page "/املاک"
@model Amlak.Web.Pages.Properties.IndexModel
@using Amlak.Web.Services.Seo
@inject IConfiguration Cfg
@{
    var site = SeoEndpoints.BaseUrl(Cfg, Model.Request);
    var siteName = Cfg["Site:Name"] ?? "آشیانه";
    var label = Model.Deal switch { DealType.Sale => "خرید ملک", DealType.Rent => "اجارهٔ ملک", _ => "آگهی‌های ملک" };
    var city = string.IsNullOrWhiteSpace(Model.City) ? null : Model.City.Trim();
    var heading = label + (city is null ? "" : " در " + city);
    var intro = SeoText.ListIntro(siteName, label == "آگهی‌های ملک" ? "ملک" : label, city, Model.Total, Model.MinFound, Model.MaxFound, Model.Deal);
    ViewData["Title"] = heading + (Model.P > 1 ? $" — صفحهٔ {Fa.Digits(Model.P.ToString())}" : "");
    ViewData["Description"] = intro + " عکس واقعی، متراژ، محله و قیمت هر آگهی.";
    // deal, city and page define the indexable page; kind/maxPrice variants collapse to it.
    ViewData["Canonical"] = SeoFiles.ListUrl(site, Model.Deal, city, Model.P);
    if (Model.Items.Count == 0) ViewData["Robots"] = "noindex, follow";

    var crumbs = new List<(string Name, string Url)> { ("خانه", site + "/"), (label, SeoFiles.ListUrl(site, Model.Deal)) };
    if (city is not null) crumbs.Add((city, SeoFiles.ListUrl(site, Model.Deal, city)));
}
@section Head {
    @Html.Raw(JsonLd.Script(JsonLd.Breadcrumbs(crumbs.ToArray())))
    @if (Model.Items.Count > 0)
    {
        @Html.Raw(JsonLd.Script(JsonLd.ItemList(Model.Items, site, Model.FirstPosition)))
    }
}
<div class="wrap">
    <nav class="crumbs" aria-label="مسیر">
        <a href="/">خانه</a> /
        @if (city is null) { <span>@label</span> }
        else { <a href="@SeoFiles.ListUrl("", Model.Deal)">@label</a> <text>/</text> <span>@city</span> }
    </nav>
    <h1 style="margin-top:8px">@heading</h1>
    <p class="lead">@intro</p>
    <form method="get" class="search" style="margin:18px 0" aria-label="فیلتر">
        <select name="deal" aria-label="نوع معامله"><option value="">همه معاملات</option><option value="Sale" selected="@(Model.Deal==DealType.Sale)">خرید</option><option value="Rent" selected="@(Model.Deal==DealType.Rent)">اجاره / رهن</option></select>
        <input name="city" value="@Model.City" placeholder="شهر" aria-label="شهر" />
        <select name="kind" aria-label="نوع ملک"><option value="">همهٔ انواع</option>
            @foreach (var k in Enum.GetValues<PropertyKind>()) { <option value="@k" selected="@(Model.Kind==k)">@(k switch { PropertyKind.Apartment=>"آپارتمان",PropertyKind.Villa=>"ویلا",PropertyKind.Land=>"زمین",PropertyKind.Commercial=>"تجاری",_=>"اداری" })</option> }
        </select>
        <input name="maxPrice" value="@Model.MaxPrice" inputmode="numeric" placeholder="سقف قیمت" aria-label="سقف قیمت" />
        <button class="btn">اعمال فیلتر</button>
    </form>
    <div class="grid">@foreach (var p in Model.Items) { <partial name="_PropertyCard" model="p" /> }</div>
    @if (Model.Items.Count == 0) { <p>آگهی‌ای با این فیلتر پیدا نشد.</p> }
    @if (Model.Pages > 1)
    {
        <nav class="pager" aria-label="صفحه‌بندی">
            @for (var i = 1; i <= Model.Pages; i++) { <a href="@Model.PageUrl(i)" aria-current="@(i==Model.P?"page":null)">@Fa.Digits(i.ToString())</a> }
        </nav>
    }
</div>
