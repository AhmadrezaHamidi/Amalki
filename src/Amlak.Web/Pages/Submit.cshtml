@page "/ثبت-آگهی"
@model SubmitModel
@{
    ViewData["Title"] = "ثبت رایگان آگهی ملک";
    ViewData["Description"] = "آگهی فروش، رهن و اجارهٔ ملک خود را رایگان ثبت کنید. پس از تأیید شمارهٔ موبایل و بررسی کارشناس، آگهی در سایت و کانال‌ها منتشر می‌شود.";
    var yn = new (string Value, string Label)[] { ("", "مشخص نشده"), ("true", "دارد"), ("false", "ندارد") };
}
<div class="wrap page-pad" style="max-width:960px">
    <nav class="crumbs" aria-label="مسیر"><a href="/">خانه</a> / ثبت آگهی</nav>
    <h1 style="margin:8px 0 4px">ثبت رایگان آگهی ملک</h1>
    <p class="hint" style="margin-bottom:20px">آگهی پس از بررسی کارشناس (معمولاً کمتر از یک روز کاری) در سایت و کانال‌های تلگرام و بله منتشر می‌شود.</p>

    @if (Model.Sent)
    {
        <div class="alert ok" role="status" style="margin-bottom:20px">آگهی شما ثبت شد و پس از بررسی منتشر می‌شود. وضعیت آن را پایین همین صفحه می‌بینید.</div>
    }

    @if (Model.Owner is null)
    {
        <section class="form-card form" aria-labelledby="login-title" style="max-width:480px">
            <h2 id="login-title">ورود با شمارهٔ موبایل</h2>
            @if (!Model.AwaitingCode)
            {
                <form method="post" asp-page-handler="SendCode">
                    <label for="Phone">شمارهٔ موبایل</label>
                    <input id="Phone" name="Phone" value="@Model.Phone" inputmode="tel" autocomplete="tel" dir="ltr" placeholder="09xxxxxxxxx" required />
                    <span asp-validation-for="Phone" class="err"></span>
                    <p class="hint">یک کد ۶ رقمی برایتان پیامک می‌شود. شماره در آگهی نمایش داده نمی‌شود.</p>
                    <button class="btn lg block" style="margin-top:12px">دریافت کد</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Verify">
                    <input type="hidden" name="Phone" value="@Model.Phone" />
                    <p>کد ارسال‌شده به <bdi dir="ltr">@Fa.Digits(Model.Phone ?? "")</bdi> را وارد کنید.</p>
                    <label for="Code">کد تأیید</label>
                    <input id="Code" name="Code" inputmode="numeric" autocomplete="one-time-code" dir="ltr" maxlength="6" required autofocus />
                    <span asp-validation-for="Code" class="err"></span>
                    <button class="btn lg block" style="margin-top:12px">تأیید و ادامه</button>
                </form>
                <form method="post" asp-page-handler="SendCode" style="margin-top:8px">
                    <input type="hidden" name="Phone" value="@Model.Phone" />
                    <button class="btn quiet sm">ارسال دوبارهٔ کد</button>
                </form>
            }
        </section>
    }
    else
    {
        <div class="row-actions" style="justify-content:space-between;margin-bottom:16px">
            <span>وارد شده با <bdi dir="ltr">@Fa.Digits(Model.Owner)</bdi></span>
            <form method="post" asp-page-handler="Logout"><button class="btn quiet sm">خروج</button></form>
        </div>

        <form method="post" enctype="multipart/form-data" class="form">
            <div asp-validation-summary="All" class="err alert bad" role="alert"></div>

            <section class="form-card">
                <h2>دسته‌بندی</h2>
                <div class="row">
                    <div><label for="Input_Deal">نوع معامله</label>
                        <select asp-for="Input.Deal" data-deal-select><option value="Sale">فروش</option><option value="Rent">رهن و اجاره</option></select></div>
                    <div><label for="Input_Kind">نوع ملک</label>
                        <select asp-for="Input.Kind">
                            @foreach (var k in Enum.GetValues<PropertyKind>()) { <option value="@k">@Labels.Kind(k)</option> }
                        </select></div>
                </div>
                <label for="Input_Title">عنوان آگهی</label>
                <input asp-for="Input.Title" placeholder="مثلاً آپارتمان ۱۰۰ متری نوساز، ۲ خواب" />
            </section>

            <section class="form-card">
                <h2>قیمت (تومان)</h2>
                <div class="row">
                    <div data-sale-only><label for="Input_Price">قیمت کل</label><input asp-for="Input.Price" inputmode="numeric" dir="ltr" data-money /><span class="hint" data-money-hint></span></div>
                    <div data-rent-only><label for="Input_Deposit">رهن (ودیعه)</label><input asp-for="Input.Deposit" inputmode="numeric" dir="ltr" data-money /><span class="hint" data-money-hint></span></div>
                    <div data-rent-only><label for="Input_MonthlyRent">اجارهٔ ماهانه</label><input asp-for="Input.MonthlyRent" inputmode="numeric" dir="ltr" data-money /><span class="hint" data-money-hint></span></div>
                </div>
                <label data-rent-only><input type="checkbox" asp-for="Input.Convertible" /> رهن و اجاره قابل تبدیل است</label>
            </section>

            <section class="form-card">
                <h2>مشخصات</h2>
                <div class="row">
                    <div><label for="Input_Area">متراژ (متر)</label><input asp-for="Input.Area" inputmode="numeric" dir="ltr" /></div>
                    <div><label for="Input_Bedrooms">خواب</label><input asp-for="Input.Bedrooms" inputmode="numeric" dir="ltr" /></div>
                    <div><label for="Input_Floor">طبقه</label><input asp-for="Input.Floor" inputmode="numeric" dir="ltr" /></div>
                    <div><label for="Input_Parking">پارکینگ</label><input asp-for="Input.Parking" inputmode="numeric" dir="ltr" /></div>
                    <div><label for="Input_YearBuilt">سال ساخت (شمسی)</label><input asp-for="Input.YearBuilt" inputmode="numeric" dir="ltr" placeholder="1400" /></div>
                </div>
                <div class="row">
                    @foreach (var (field, label, value) in new[] { ("HasElevator", "آسانسور", Model.Input.HasElevator), ("HasStorage", "انباری", Model.Input.HasStorage), ("HasBalcony", "بالکن", Model.Input.HasBalcony) })
                    {
                        <div><label for="Input_@field">@label</label>
                            <select id="Input_@field" name="Input.@field">
                                @foreach (var o in yn) { <option value="@o.Value" selected="@(o.Value == (value?.ToString().ToLowerInvariant() ?? ""))">@o.Label</option> }
                            </select></div>
                    }
                    <div><label for="Input_Deed">سند</label>
                        <select asp-for="Input.Deed">
                            <option value="">مشخص نشده</option>
                            @foreach (var d in Enum.GetValues<DeedType>()) { <option value="@d">@Labels.Deed(d)</option> }
                        </select></div>
                </div>
                <label for="Input_Description">توضیحات</label>
                <textarea asp-for="Input.Description" rows="6" placeholder="ویژگی‌ها، امکانات، دسترسی‌ها…"></textarea>
            </section>

            <section class="form-card">
                <h2>موقعیت و تماس</h2>
                <div class="row">
                    <div><label for="Input_City">شهر</label><input asp-for="Input.City" /></div>
                    <div><label for="Input_District">محله</label><input asp-for="Input.District" /></div>
                    <div><label for="Input_OwnerName">نام شما</label><input asp-for="Input.OwnerName" autocomplete="name" /></div>
                </div>
                <label class="hp" aria-hidden="true">وب‌سایت<input asp-for="Input.Website" tabindex="-1" autocomplete="off" /></label>
            </section>

            <section class="form-card">
                <h2>عکس‌ها</h2>
                <label for="Uploads">تا @Fa.Digits(SubmitModel.MaxPhotos.ToString()) عکس (JPG / PNG / WebP، هر کدام حداکثر ۵ مگابایت)</label>
                <input type="file" id="Uploads" name="Uploads" accept="image/jpeg,image/png,image/webp" multiple />
                <p class="hint">آگهی‌های عکس‌دار بیشتر دیده می‌شوند. عکس اول، عکس اصلی آگهی است.</p>
            </section>

            <button class="btn lg">ارسال برای بررسی</button>
        </form>

        @if (Model.Mine.Count > 0)
        {
            <section class="form-card" style="margin-top:24px" aria-labelledby="mine-title">
                <h2 id="mine-title">آگهی‌های من</h2>
                <ul class="mine">
                    @foreach (var p in Model.Mine)
                    {
                        <li>
                            @if (p.Status == ListingStatus.Published) { <a href="/ملک/@p.Slug">@p.Title</a> } else { <span>@p.Title</span> }
                            <span class="badge soft">@Labels.Status(p.Status)</span>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>
