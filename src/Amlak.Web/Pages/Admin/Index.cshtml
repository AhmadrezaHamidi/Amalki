@page
@model Amlak.Web.Pages.Admin.IndexModel
@{ ViewData["Title"] = "داشبورد"; ViewData["Robots"] = "noindex,nofollow"; }
<div class="admin-page">
    <div class="admin-head">
        <div><h1>داشبورد</h1><p class="hint">خلاصهٔ کارهایی که منتظر توست</p></div>
        <div class="row-actions">
            <a class="btn quiet" href="/" target="_blank" rel="noopener">مشاهدهٔ سایت</a>
            <a class="btn" asp-page="Edit">+ آگهی جدید</a>
        </div>
    </div>
    <div class="stats">
        <a class="stat" asp-page="Listings"><span>آگهی منتشرشده</span><strong>@Fa.Digits(Model.Published.ToString())</strong><small>@Fa.Digits(Model.Drafts.ToString()) پیش‌نویس</small></a>
        <a class="stat @(Model.NewLeads > 0 ? "hot" : "")" asp-page="Leads"><span>درخواست تماس جدید</span><strong>@Fa.Digits(Model.NewLeads.ToString())</strong><small>پیگیری‌نشده</small></a>
        <a class="stat @(Model.OpenTickets > 0 ? "hot" : "")" asp-page="Tickets"><span>تیکت در انتظار پاسخ</span><strong>@Fa.Digits(Model.OpenTickets.ToString())</strong><small>@Fa.Digits(Model.AnsweredTickets.ToString()) پاسخ‌داده و باز</small></a>
        <a class="stat @(Model.ChannelErrors > 0 ? "alert-stat" : "")" asp-page="Listings"><span>خطای ارسال به کانال</span><strong>@Fa.Digits(Model.ChannelErrors.ToString())</strong><small>@(Model.ChannelErrors == 0 ? "همه سالم" : "در صفحهٔ آگهی ببینید")@(Model.EventsPending > 0 ? $" · {Fa.Digits(Model.EventsPending.ToString())} در صف" : "")@(Model.EventsFailed > 0 ? $" · {Fa.Digits(Model.EventsFailed.ToString())} ناموفق" : "")</small></a>
    </div>

    <div class="dash-grid">
        <section class="form-card" aria-labelledby="dash-tickets">
            <div class="section-head" style="margin-bottom:8px"><h2 id="dash-tickets">تیکت‌های باز</h2><a class="more" asp-page="Tickets">همهٔ تیکت‌ها</a></div>
            @if (Model.Tickets.Count == 0) { <p class="hint">تیکت بازی نیست.</p> }
            <ul class="dash-list">
                @foreach (var t in Model.Tickets)
                {
                    <li>
                        <a href="/Admin/Tickets?id=@t.Id">
                            <span class="avatar">@(t.Name.Length > 0 ? t.Name[..1] : "?")</span>
                            <span class="grow"><strong>@t.Subject</strong><small>@t.Name · @Labels.Category(t.Category)</small></span>
                            <span class="pill @(t.Status == TicketStatus.Open ? "wait" : "pub")">@Labels.Status(t.Status)</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
        <section class="form-card" aria-labelledby="dash-leads">
            <div class="section-head" style="margin-bottom:8px"><h2 id="dash-leads">درخواست‌های تماس تازه</h2><a class="more" asp-page="Leads">همه</a></div>
            @if (Model.Leads.Count == 0) { <p class="hint">درخواست پیگیری‌نشده‌ای نیست.</p> }
            <ul class="dash-list">
                @foreach (var l in Model.Leads)
                {
                    <li>
                        <div>
                            <span class="grow"><strong>@l.Name <bdi dir="ltr" class="hint">@Fa.Digits(l.Phone)</bdi></strong><small>@(l.PropertyTitle ?? "مشاورهٔ عمومی")</small></span>
                            <a class="btn sm ghost" href="tel:@l.Phone">تماس</a>
                        </div>
                    </li>
                }
            </ul>
        </section>
    </div>

    @if (Model.Notice is not null) { <div class="alert ok" role="status">@Model.Notice</div> }
    @if (Model.PhotosWithoutCopies > 0)
    {
        <form method="post" asp-page-handler="BackfillPhotos" class="form-card row-actions" style="justify-content:space-between">
            <span><strong style="display:block">@Fa.Digits(Model.PhotosWithoutCopies.ToString()) عکس قدیمی بدون نسخهٔ سبک</strong><span class="hint">ساخت نسخه‌های WebP تا صفحه‌ها روی موبایل سریع‌تر باز شوند (هر بار تا ۴۰ عکس).</span></span>
            <button class="btn">ساخت نسخه‌های WebP</button>
        </form>
    }

    <section class="form-card row-actions" style="justify-content:space-between">
        <span><strong style="display:block">کانال‌ها</strong><span class="hint">انتشار خودکار آگهی‌ها</span></span>
        <span class="row-actions">
            <span class="pill @(Model.Channels.Contains(Messenger.Telegram) ? "pub" : "draft")">تلگرام: @(Model.Channels.Contains(Messenger.Telegram) ? "تنظیم‌شده" : "تنظیم نشده")</span>
            <span class="pill @(Model.Channels.Contains(Messenger.Bale) ? "pub" : "draft")">بله: @(Model.Channels.Contains(Messenger.Bale) ? "تنظیم‌شده" : "تنظیم نشده")</span>
        </span>
    </section>

    @* Real-user monitoring: what visitors' own phones measured (WebVitals). *@
    <section class="form-card" aria-labelledby="dash-speed">
        <div class="section-head" style="margin-bottom:8px"><h2 id="dash-speed">سرعت سایت از دید بازدیدکننده‌ها</h2><span class="hint">۷۵٪ بازدیدها، ۲۴ ساعت اخیر</span></div>
        @if (Model.Vitals.Count == 0)
        {
            <p class="hint">هنوز گزارشی نرسیده. هر بازدیدکننده هنگام ترک صفحه سرعتی را که گوشی‌اش دیده می‌فرستد.</p>
        }
        else
        {
            string Page(string p) => p switch { "home" => "صفحهٔ اصلی", "list" => "فهرست آگهی‌ها", "detail" => "صفحهٔ آگهی", _ => "سایر صفحه‌ها" };
            string Show(WebVitals.Summary? x) => x is null ? "—" : x.Metric == "cls" ? Fa.Digits(x.P75.ToString("0.00")) : Fa.Digits((x.P75 / 1000).ToString("0.0")) + " ث";
            string Css(WebVitals.Summary? x) => x is null ? "" : x.Rating switch { "good" => "pub", "ni" => "wait", _ => "closed" };
            <div class="tablewrap">
                <table class="table">
                    <thead><tr><th>صفحه</th><th title="بزرگ‌ترین بخش صفحه کِی دیده شد">LCP</th><th title="پاسخ به لمس و کلیک">INP</th><th title="جابه‌جا شدن صفحه">CLS</th><th title="اولین بایت از سرور">TTFB</th><th>نمونه</th></tr></thead>
                    <tbody>
                    @foreach (var page in WebVitals.PageTypes.Where(p => Model.Vitals.Any(v => v.Page == p)))
                    {
                        var row = Model.Vitals.Where(v => v.Page == page).ToDictionary(v => v.Metric);
                        <tr>
                            <td>@Page(page)</td>
                            @foreach (var m in new[] { "lcp", "inp", "cls", "ttfb" })
                            {
                                var x = row.GetValueOrDefault(m);
                                <td><span class="pill @Css(x)">@Show(x)</span></td>
                            }
                            <td>@Fa.Digits(row.Values.Max(v => v.Samples).ToString())</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="hint">معیار گوگل برای «خوب»: LCP زیر ۲٫۵ ثانیه، INP زیر ۰٫۲ ثانیه، CLS زیر ۰٫۱، TTFB زیر ۰٫۸ ثانیه.</p>
        }
    </section>
</div>
