@page "{id:int?}"
@model Amlak.Web.Pages.Admin.EditModel
@{
    ViewData["Title"] = Model.Id is null ? "آگهی جدید" : "ویرایش آگهی";
    ViewData["Robots"] = "noindex,nofollow";
}
<div class="wrap page-pad" style="max-width:960px">
    <nav class="crumbs" aria-label="مسیر"><a asp-page="Listings">آگهی‌ها</a> / @ViewData["Title"]</nav>
    <div class="admin-head" style="margin-top:8px">
        <h1>@ViewData["Title"]</h1>
        @if (Model.Id is not null && Model.Input.Status == ListingStatus.Published)
        {
            <a class="btn quiet" href="/ملک/@Model.Slug" target="_blank" rel="noopener">مشاهده در سایت</a>
        }
    </div>

    <form method="post" enctype="multipart/form-data" class="form" data-deal-form>
        <div asp-validation-summary="All" class="err alert bad" role="alert"></div>
        @if (TempData["Error"] is string error) { <div class="err alert bad" role="alert">@error</div> }

        <section class="form-card">
            <h2>اطلاعات اصلی</h2>
            <label for="Input_Title">عنوان</label>
            <input asp-for="Input.Title" placeholder="مثلاً آپارتمان ۱۲۰ متری نوساز" />
            <div class="row">
                <div><label for="Input_Deal">نوع معامله</label>
                    <select asp-for="Input.Deal" data-deal-select><option value="Sale">فروش</option><option value="Rent">اجاره / رهن</option></select></div>
                <div><label for="Input_Kind">نوع ملک</label>
                    <select asp-for="Input.Kind">
                        @foreach (var k in Enum.GetValues<PropertyKind>()) { <option value="@k">@Labels.Kind(k)</option> }
                    </select></div>
                <div><label for="Input_Status">وضعیت</label>
                    <select asp-for="Input.Status"><option value="Pending">در انتظار بررسی</option><option value="Draft">پیش‌نویس</option><option value="Published">منتشرشده</option><option value="Closed">بسته‌شده</option></select></div>
            </div>
            <p class="hint">با «منتشرشده»، آگهی در سایت و کانال‌های تلگرام و بله قرار می‌گیرد.</p>
            @if (Model.OwnerPhone is not null)
            {
                <p class="alert ok" style="margin-top:12px">ثبت‌شده توسط کاربر: @Model.OwnerName — <bdi dir="ltr"><a href="tel:@Model.OwnerPhone">@Model.OwnerPhone</a></bdi> (موبایل تأییدشده)</p>
            }
        </section>

        <section class="form-card">
            <h2>قیمت (تومان)</h2>
            <div class="row">
                <div data-sale-only><label for="Input_Price">قیمت فروش</label><input asp-for="Input.Price" inputmode="numeric" dir="ltr" data-money /><span class="hint" data-money-hint></span></div>
                <div data-rent-only><label for="Input_Deposit">رهن</label><input asp-for="Input.Deposit" inputmode="numeric" dir="ltr" data-money /><span class="hint" data-money-hint></span></div>
                <div data-rent-only><label for="Input_MonthlyRent">اجارهٔ ماهانه</label><input asp-for="Input.MonthlyRent" inputmode="numeric" dir="ltr" data-money /><span class="hint" data-money-hint></span></div>
            </div>
            <label data-rent-only><input type="checkbox" asp-for="Input.Convertible" /> رهن و اجاره قابل تبدیل است</label>
            <p class="hint">مبلغ کامل را به تومان بنویسید؛ زیر هر خانه شکل خوانای آن نمایش داده می‌شود.</p>
        </section>

        <section class="form-card">
            <h2>مشخصات</h2>
            <div class="row">
                <div><label for="Input_AreaM2">متراژ (متر)</label><input asp-for="Input.AreaM2" inputmode="numeric" dir="ltr" /></div>
                <div><label for="Input_Bedrooms">خواب</label><input asp-for="Input.Bedrooms" inputmode="numeric" dir="ltr" /></div>
                <div><label for="Input_Floor">طبقه</label><input asp-for="Input.Floor" inputmode="numeric" dir="ltr" /></div>
                <div><label for="Input_Parking">پارکینگ</label><input asp-for="Input.Parking" inputmode="numeric" dir="ltr" /></div>
                <div><label for="Input_YearBuilt">سال ساخت (شمسی)</label><input asp-for="Input.YearBuilt" inputmode="numeric" dir="ltr" placeholder="1403" /></div>
            </div>
            <div class="row">
                @foreach (var (field, label, value) in new[] { ("HasElevator", "آسانسور", Model.Input.HasElevator), ("HasStorage", "انباری", Model.Input.HasStorage), ("HasBalcony", "بالکن", Model.Input.HasBalcony) })
                {
                    <div><label for="Input_@field">@label</label>
                        <select id="Input_@field" name="Input.@field">
                            <option value="" selected="@(value is null)">مشخص نشده</option>
                            <option value="true" selected="@(value == true)">دارد</option>
                            <option value="false" selected="@(value == false)">ندارد</option>
                        </select></div>
                }
                <div><label for="Input_Deed">سند</label>
                    <select asp-for="Input.Deed">
                        <option value="">مشخص نشده</option>
                        @foreach (var d in Enum.GetValues<DeedType>()) { <option value="@d">@Labels.Deed(d)</option> }
                    </select></div>
            </div>
            <label for="Input_Description">توضیحات</label>
            <textarea asp-for="Input.Description" rows="7" placeholder="ویژگی‌ها، امکانات، دسترسی‌ها…"></textarea>
        </section>

        <section class="form-card">
            <h2>موقعیت</h2>
            <div class="row">
                <div><label for="Input_City">شهر</label><input asp-for="Input.City" /></div>
                <div><label for="Input_District">محله</label><input asp-for="Input.District" /></div>
            </div>
            <label for="Input_Address">نشانی (اختیاری، در سایت نمایش داده نمی‌شود)</label>
            <input asp-for="Input.Address" />
            <div class="row">
                <div><label for="Input_Latitude">عرض جغرافیایی</label><input asp-for="Input.Latitude" dir="ltr" placeholder="35.7" /></div>
                <div><label for="Input_Longitude">طول جغرافیایی</label><input asp-for="Input.Longitude" dir="ltr" placeholder="51.4" /></div>
            </div>
            <p class="hint">با پر کردن مختصات، نقشهٔ تقریبی در صفحهٔ آگهی نمایش داده می‌شود.</p>
        </section>

        <section class="form-card">
            <h2>عکس‌ها</h2>
            <label for="Uploads">افزودن عکس (JPG / PNG / WebP، هر کدام حداکثر ۵ مگابایت)</label>
            <input type="file" id="Uploads" name="Uploads" accept="image/jpeg,image/png,image/webp" multiple />
            <p class="hint">عکس اول، عکس اصلی آگهی و پست کانال‌هاست.</p>
        </section>

        <div class="row-actions"><button class="btn lg">ذخیره</button><a class="btn quiet lg" asp-page="Listings">انصراف</a></div>
    </form>

    @if (Model.Photos.Count > 0)
    {
        <section class="form-card" style="margin-top:24px">
            <h2>عکس‌های فعلی</h2>
            <p class="hint">عکس اول، عکس اصلی آگهی است: در کارت‌ها، پیش‌نمایش لینک و پست کانال‌ها همین عکس دیده می‌شود.</p>
            <div class="photo-grid" style="margin-top:12px">
                @foreach (var (f, i) in Model.Photos.Select((f, i) => (f, i)))
                {
                    var last = i == Model.Photos.Count - 1;
                    <figure>
                        <img src="@f.Url" alt="@f.Alt" loading="lazy" />
                        <form method="post" asp-page-handler="MovePhoto" asp-route-id="@Model.Id" asp-route-photoId="@f.Id" class="photo-order" aria-label="ترتیب عکس @Fa.Digits((i + 1).ToString())">
                            @if (i == 0) { <span class="badge soft">عکس اصلی</span> }
                            else { <button class="btn sm quiet" name="move" value="First">عکس اصلی شود</button> }
                            <span class="row-actions">
                                <button class="btn sm quiet icon" name="move" value="Earlier" disabled="@(i == 0)" aria-label="جلوتر">@Icons.Get("chev-right", 16)</button>
                                <button class="btn sm quiet icon" name="move" value="Later" disabled="@last" aria-label="عقب‌تر">@Icons.Get("chev-left", 16)</button>
                            </span>
                        </form>
                        <form method="post" asp-page-handler="DeletePhoto" asp-route-id="@Model.Id" asp-route-photoId="@f.Id" onsubmit="return confirm('این عکس حذف شود؟')">
                            <span class="hint">@Fa.Digits((i + 1).ToString())</span>
                            <button class="btn sm danger">حذف</button>
                        </form>
                    </figure>
                }
            </div>
        </section>
    }

    @if (Model.Id is not null)
    {
        <section class="form-card">
            <h2>کانال‌ها</h2>
            @if (Model.Configured.Count == 0)
            {
                <p class="hint">هیچ ربات تلگرام یا بله‌ای تنظیم نشده است (Telegram:BotToken / Bale:BotToken در user-secrets).</p>
            }
            else
            {
                foreach (var ch in Model.Configured)
                {
                    var post = Model.Posts.FirstOrDefault(x => x.Channel == ch);
                    <p>
                        <strong>@(ch == Channel.Telegram ? "تلگرام" : "بله"):</strong>
                        @if (post?.ExternalMessageId is not null && post.Error is null) { <span class="ch-ok">ارسال شده</span> }
                        else if (post?.Error is not null) { <span class="err">خطا: @post.Error</span> }
                        else { <span class="hint">ارسال نشده (آگهی منتشر نشده)</span> }
                    </p>
                }
                <form method="post" asp-page-handler="Republish" asp-route-id="@Model.Id" style="margin-top:8px"><button class="btn sm ghost">همگام‌سازی دوباره با کانال‌ها</button></form>
            }
        </section>
    }
</div>
