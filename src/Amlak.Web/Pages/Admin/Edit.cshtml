@page "{id:int?}"
@model Amlak.Web.Pages.Admin.EditModel
@{
    ViewData["Title"] = Model.Id is null ? "آگهی جدید" : "ویرایش آگهی";
    ViewData["Robots"] = "noindex,nofollow";
}
<div class="wrap">
    <p class="crumbs"><a asp-page="Index">← بازگشت به لیست</a></p>
    <h1 style="margin:8px 0 20px">@ViewData["Title"]</h1>

    <form method="post" enctype="multipart/form-data" class="form panel" style="position:static">
        <div asp-validation-summary="All" class="err" role="alert"></div>

        <label for="Input_Title">عنوان</label>
        <input asp-for="Input.Title" />

        <div class="row">
            <div><label for="Input_Deal">نوع معامله</label>
                <select asp-for="Input.Deal"><option value="Sale">فروش</option><option value="Rent">اجاره / رهن</option></select></div>
            <div><label for="Input_Kind">نوع ملک</label>
                <select asp-for="Input.Kind">
                    <option value="Apartment">آپارتمان</option><option value="Villa">ویلا</option><option value="Land">زمین</option>
                    <option value="Commercial">تجاری</option><option value="Office">اداری</option>
                </select></div>
            <div><label for="Input_Status">وضعیت</label>
                <select asp-for="Input.Status"><option value="Draft">پیش‌نویس</option><option value="Published">منتشرشده</option><option value="Closed">بسته‌شده</option></select></div>
        </div>

        <div class="row">
            <div><label for="Input_Price">قیمت فروش (تومان)</label><input asp-for="Input.Price" inputmode="numeric" dir="ltr" /></div>
            <div><label for="Input_Deposit">رهن (تومان)</label><input asp-for="Input.Deposit" inputmode="numeric" dir="ltr" /></div>
            <div><label for="Input_MonthlyRent">اجارهٔ ماهانه (تومان)</label><input asp-for="Input.MonthlyRent" inputmode="numeric" dir="ltr" /></div>
        </div>
        <p class="hint">برای فروش فقط «قیمت»، برای اجاره «رهن» و «اجاره» را پر کنید.</p>
        <label for="Input_PriceDisplay">نمایش قیمت در سایت، کانال و پیامک</label>
        <select asp-for="Input.PriceDisplay">
            <option value="Full">قیمت کل و قیمت هر متر</option><option value="TotalOnly">فقط قیمت کل</option><option value="Negotiable">توافقی (قیمت پنهان)</option>
        </select>

        <div class="row">
            <div><label for="Input_AreaM2">متراژ</label><input asp-for="Input.AreaM2" inputmode="numeric" dir="ltr" /></div>
            <div><label for="Input_Bedrooms">خواب</label><input asp-for="Input.Bedrooms" inputmode="numeric" dir="ltr" /></div>
            <div><label for="Input_Floor">طبقه</label><input asp-for="Input.Floor" inputmode="numeric" dir="ltr" /></div>
            <div><label for="Input_Parking">پارکینگ</label><input asp-for="Input.Parking" inputmode="numeric" dir="ltr" /></div>
            <div><label for="Input_YearBuilt">سال ساخت</label><input asp-for="Input.YearBuilt" inputmode="numeric" dir="ltr" /></div>
        </div>

        <div class="row">
            <div><label for="Input_City">شهر</label><input asp-for="Input.City" /></div>
            <div><label for="Input_District">محله</label><input asp-for="Input.District" /></div>
        </div>
        <label for="Input_Address">نشانی (اختیاری، نمایش داده نمی‌شود)</label>
        <input asp-for="Input.Address" />
        <div class="row">
            <div><label for="Input_Latitude">عرض جغرافیایی</label><input asp-for="Input.Latitude" dir="ltr" /></div>
            <div><label for="Input_Longitude">طول جغرافیایی</label><input asp-for="Input.Longitude" dir="ltr" /></div>
        </div>

        <label for="Input_Description">توضیحات</label>
        <textarea asp-for="Input.Description" rows="7"></textarea>

        <label for="Uploads">عکس‌ها (JPG / PNG / WebP، حداکثر ۵ مگابایت)</label>
        <input type="file" id="Uploads" name="Uploads" accept="image/jpeg,image/png,image/webp" multiple />

        <button class="btn" style="margin-top:18px">ذخیره</button>
    </form>

    @if (Model.Id is not null)
    {
        <h2>کانال‌ها</h2>
        <div class="panel" style="position:static">
            @if (Model.Configured.Count == 0)
            {
                <p class="hint">هیچ ربات تلگرام یا بله‌ای تنظیم نشده است (Telegram:BotToken / Bale:BotToken در user-secrets).</p>
            }
            else
            {
                foreach (var ch in Model.Configured)
                {
                    var post = Model.Posts.FirstOrDefault(x => x.Channel == ch);
                    <p>
                        <strong>@(ch == Channel.Telegram ? "تلگرام" : "بله"):</strong>
                        @if (post?.ExternalMessageId is not null) { <span>ارسال شده</span> }
                        else if (post?.Error is not null) { <span class="err">خطا: @post.Error</span> }
                        else { <span>ارسال نشده (آگهی منتشر نشده)</span> }
                    </p>
                }
                <form method="post" asp-page-handler="Republish" asp-route-id="@Model.Id"><button class="btn sm ghost">همگام‌سازی دوباره با کانال‌ها</button></form>
            }
        </div>
    }

    @if (Model.Photos.Count > 0)
    {
        <h2>عکس‌های آگهی</h2>
        <div class="grid">
            @foreach (var f in Model.Photos)
            {
                <figure class="card" style="margin:0">
                    <div class="ph"><img src="@f.Url" alt="@f.Alt" loading="lazy" /></div>
                    <form method="post" asp-page-handler="DeletePhoto" asp-route-id="@Model.Id" asp-route-photoId="@f.Id" style="padding:10px">
                        <button class="btn sm danger">حذف عکس</button>
                    </form>
                </figure>
            }
        </div>
    }
</div>
