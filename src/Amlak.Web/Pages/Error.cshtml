@page
@model ErrorModel
@{
    var notFound = Model.Code == 404;
    ViewData["Title"] = notFound ? "صفحه پیدا نشد" : "خطا";
    ViewData["Robots"] = "noindex";
}
<div class="wrap empty-state page-pad">
    <svg aria-hidden="true" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 14h4"/></svg>
    <h1>@(notFound ? "این صفحه پیدا نشد" : "مشکلی پیش آمد")</h1>
    <p>@(notFound ? "شاید آگهی فروخته یا اجاره داده شده، یا نشانی اشتباه است." : "لطفاً چند لحظهٔ دیگر دوباره امتحان کنید.")</p>
    <div class="row-actions">
        <a class="btn" asp-page="/Properties/Index">دیدن آگهی‌های فعال</a>
        <a class="btn ghost" href="/">صفحهٔ اصلی</a>
    </div>
    @if (!notFound && Model.ShowRequestId) { <p class="hint">کد پیگیری: <code dir="ltr">@Model.RequestId</code></p> }
</div>
