@page "/پیگیری"
@model TrackModel
@using Amlak.Web.Services.Sms
@{
    ViewData["Title"] = "پیگیری خانه با پیامک";
    ViewData["Description"] = "شرایط خانهٔ دلخواهتان را بگویید؛ هر آگهی تازه یا کاهش قیمتی که با آن بخواند، همان موقع برایتان پیامک می‌شود.";
}
<div class="wrap page-pad" style="max-width:760px">
    <nav class="crumbs" aria-label="مسیر"><a href="/">خانه</a> / پیگیری با پیامک</nav>
    <h1 style="margin:8px 0 4px">پیگیری خانه با پیامک</h1>
    <p class="hint" style="margin-bottom:20px">شرایطتان را بگویید؛ هر آگهی تازه یا کاهش قیمتی که با آن بخواند، همان موقع پیامک می‌شود. برای لغو، «@SmsText.OptOutFooter» را پاسخ دهید یا از همین صفحه لغو کنید.</p>

    @if (Model.Saved)
    {
        <div class="alert ok" role="status" style="margin-bottom:20px">پیگیری فعال شد. از این پس آگهی‌های مطابق شرایط شما پیامک می‌شوند.</div>
    }

    @if (Model.Owner is null)
    {
        <section class="form-card form" aria-labelledby="login-title" style="max-width:480px">
            <h2 id="login-title">ورود با شمارهٔ موبایل</h2>
            @if (!Model.AwaitingCode)
            {
                <form method="post" asp-page-handler="SendCode">
                    <label for="Phone">شمارهٔ موبایل</label>
                    <input id="Phone" name="Phone" value="@Model.Phone" inputmode="tel" autocomplete="tel" dir="ltr" placeholder="09xxxxxxxxx" required />
                    <span asp-validation-for="Phone" class="err"></span>
                    <p class="hint">یک کد ۶ رقمی برایتان پیامک می‌شود. پیامک‌های پیگیری به همین شماره می‌آیند.</p>
                    <button class="btn lg block" style="margin-top:12px">دریافت کد</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Verify">
                    <input type="hidden" name="Phone" value="@Model.Phone" />
                    <p>کد ارسال‌شده به <bdi dir="ltr">@Fa.Digits(Model.Phone ?? "")</bdi> را وارد کنید.</p>
                    <label for="Code">کد تأیید</label>
                    <input id="Code" name="Code" inputmode="numeric" autocomplete="one-time-code" dir="ltr" maxlength="6" required autofocus />
                    <span asp-validation-for="Code" class="err"></span>
                    <button class="btn lg block" style="margin-top:12px">تأیید و ادامه</button>
                </form>
                <form method="post" asp-page-handler="SendCode" style="margin-top:8px">
                    <input type="hidden" name="Phone" value="@Model.Phone" />
                    <button class="btn quiet sm">ارسال دوبارهٔ کد</button>
                </form>
            }
        </section>
    }
    else
    {
        <div class="row-actions" style="justify-content:space-between;margin-bottom:16px">
            <span>وارد شده با <bdi dir="ltr">@Fa.Digits(Model.Owner)</bdi></span>
            <form method="post" asp-page-handler="Logout"><button class="btn quiet sm">خروج</button></form>
        </div>

        <form method="post" class="form">
            <div asp-validation-summary="All" class="err alert bad" role="alert"></div>
            <section class="form-card">
                <h2>چه خانه‌ای می‌خواهید؟</h2>
                <div class="row">
                    <div><label for="Input_Deal">نوع معامله</label>
                        <select asp-for="Input.Deal">@foreach (var d in Enum.GetValues<DealType>()) { <option value="@d">@Labels.Deal(d)</option> }</select></div>
                    <div><label for="Input_Kind">نوع ملک</label>
                        <select asp-for="Input.Kind">
                            <option value="">فرقی ندارد</option>
                            @foreach (var k in Enum.GetValues<PropertyKind>()) { <option value="@k">@Labels.Kind(k)</option> }
                        </select></div>
                </div>
                <div class="row">
                    <div><label for="Input_City">شهر</label><input asp-for="Input.City" placeholder="مثلاً تهران" /><span asp-validation-for="Input.City" class="err"></span></div>
                    <div><label for="Input_Districts">محله‌ها (اختیاری)</label><input asp-for="Input.Districts" placeholder="سعادت‌آباد، شهرک غرب" /></div>
                </div>
                <div class="row">
                    <div><label for="Input_MaxBudget">حداکثر بودجه (تومان)</label><input asp-for="Input.MaxBudget" inputmode="numeric" dir="ltr" data-money /><span class="hint" data-money-hint></span><span asp-validation-for="Input.MaxBudget" class="err"></span></div>
                    <div><label for="Input_MinBedrooms">حداقل خواب</label><input asp-for="Input.MinBedrooms" inputmode="numeric" dir="ltr" /></div>
                </div>
                <p class="hint">برای رهن و اجاره، بودجه با «معادل رهن کامل» مقایسه می‌شود (هر ۱ میلیون اجاره ≈ ۳۳ میلیون رهن).</p>
                <label><input type="checkbox" asp-for="Input.NotifyNew" /> آگهی تازهٔ مطابق شرایط</label>
                <label><input type="checkbox" asp-for="Input.NotifyPriceDrop" /> کاهش قیمت آگهی‌هایی که برایم پیامک شده</label>
                <label for="Input_Name">نام (اختیاری، برای پیامک)</label>
                <input asp-for="Input.Name" autocomplete="name" />
                <button class="btn lg block" style="margin-top:16px">شروع پیگیری</button>
            </section>
        </form>

        @if (Model.Mine.Count > 0)
        {
            <section class="form-card" style="margin-top:24px" aria-labelledby="mine-title">
                <h2 id="mine-title">پیگیری‌های فعال من</h2>
                <ul class="mine">
                    @foreach (var s in Model.Mine)
                    {
                        <li>
                            <span>@Labels.Deal(s.Deal)@(s.Kind is { } k ? " " + Labels.Kind(k) : "") در @s.City@(s.Districts.Length > 0 ? "، " + s.Districts : "")@(s.MaxBudget is { } max ? " · تا " + Fa.Money(max) : "")</span>
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@s.Id"><button class="btn quiet sm">لغو</button></form>
                        </li>
                    }
                </ul>
                <form method="post" asp-page-handler="StopAll" style="margin-top:12px"><button class="btn quiet sm">لغو همه و قطع همهٔ پیامک‌های تبلیغاتی</button></form>
            </section>
        }
    }
</div>
