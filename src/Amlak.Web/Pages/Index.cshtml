@page
@model IndexModel
@using Amlak.Web.Services.Seo
@{
    ViewData["Title"] = "خرید، فروش و اجارهٔ ملک";
    ViewData["BodyClass"] = "home";
    var cfg = Model.HttpContext.RequestServices.GetRequiredService<IConfiguration>();
    var site = (cfg["Site:BaseUrl"] ?? $"{Model.Request.Scheme}://{Model.Request.Host}").TrimEnd('/');
    var faq = new (string Q, string A)[]
    {
        ("آگهی‌ها چطور بررسی می‌شوند؟", "هر آگهی پیش از انتشار توسط تیم ما بررسی می‌شود و عکس‌ها از خود ملک است."),
        ("برای بازدید ملک باید چه کنم؟", "در صفحهٔ هر ملک فرم «درخواست تماس» را پر کنید؛ مشاور برای تعیین زمان بازدید با شما تماس می‌گیرد."),
        ("قیمت‌های اعلام‌شده قطعی است؟", "قیمت اعلام‌شده نظر مالک است و ممکن است در مذاکره تغییر کند."),
        ("چطور ملکم را برای فروش یا اجاره ثبت کنم؟", "فرم «ثبت ملک و مشاوره» را پر کنید؛ کارشناس برای بازدید، قیمت‌گذاری و عکاسی هماهنگ می‌کند."),
        ("آگهی‌های جدید را کجا ببینم؟", "همهٔ آگهی‌ها هم‌زمان با سایت در کانال تلگرام و بلهٔ ما هم منتشر می‌شوند."),
    };
    var faqLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org", ["@type"] = "FAQPage",
        ["mainEntity"] = faq.Select(f => new Dictionary<string, object>
        {
            ["@type"] = "Question", ["name"] = f.Q,
            ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = f.A },
        }).ToArray(),
    };
}
@section Head {
    @foreach (var node in JsonLd.Site(cfg["Site:Name"] ?? "آشیانه", site))
    {
        <script type="application/ld+json">@Html.Raw(JsonLd.Serialize(node))</script>
    }
    <script type="application/ld+json">@Html.Raw(JsonLd.Serialize(faqLd))</script>
}

<section class="home-hero">
    <div class="wrap">
        <h1>خرید، رهن و اجارهٔ ملک<br /><span>با آگهی‌های بررسی‌شده و عکس واقعی</span></h1>
        <form class="home-search" method="get" action="@Taxonomy.Root" role="search" aria-label="جست‌وجوی ملک">
            <fieldset class="tabs">
                <legend class="sr-only">نوع معامله</legend>
                <label><input type="radio" name="deal" value="Sale" checked /><span>خرید</span></label>
                <label><input type="radio" name="deal" value="Rent" /><span>رهن و اجاره</span></label>
                <label><input type="radio" name="deal" value="ShortTerm" /><span>روزانه</span></label>
            </fieldset>
            <div class="home-search-row">
                <label class="home-q">@Icons.Get("search", 20)<span class="sr-only">محله، شهر یا عنوان</span>
                    <input name="q" placeholder="محله، شهر یا عنوان آگهی" autocomplete="off" enterkeyhint="search" /></label>
                <button class="btn lg">جست‌وجو</button>
            </div>
        </form>
        <div class="trust">
            <span>@Icons.Get("shield", 18) بررسی پیش از انتشار</span>
            <span>@Icons.Get("photo", 18) عکس واقعی</span>
            <span>@Icons.Get("user", 18) مشاور اختصاصی</span>
        </div>
    </div>
</section>

<div class="wrap">
    <section class="section first" aria-labelledby="cats-title">
        <h2 id="cats-title" class="sr-only">دسته‌بندی‌ها</h2>
        <nav class="cats" aria-label="دسته‌بندی آگهی‌ها">
            @foreach (var (slug, label, icon) in new[] {
                ("خرید-آپارتمان", "خرید آپارتمان", "apartment"), ("اجاره-آپارتمان", "اجارهٔ آپارتمان", "key"),
                ("خرید-ویلا", "خانه و ویلا", "villa"), ("اجاره-کوتاه-مدت", "اجارهٔ روزانه", "clock"),
                ("خرید-زمین", "زمین و کلنگی", "land"), ("خرید-مغازه", "مغازه و تجاری", "commercial"),
                ("خرید-دفتر-اداری", "دفتر اداری", "office"), ("رهن-و-اجاره", "همهٔ اجاره‌ها", "home") })
            {
                <a class="cat" href="@Taxonomy.EncodedPath(null, Taxonomy.Find(slug))"><span class="cat-ico">@Icons.Get(icon, 26)</span>@label</a>
            }
        </nav>
    </section>

    @if (Model.TopAreas.Count > 0)
    {
        <section class="section" aria-labelledby="areas-title">
            <div class="section-head"><h2 id="areas-title">محله‌های پرآگهی</h2></div>
            <div class="area-chips">
                @foreach (var a in Model.TopAreas)
                {
                    <a class="chip" href="@Taxonomy.EncodedPath(a.City, Taxonomy.Find("خرید"), a.District)">@Icons.Get("map", 16) @a.District <small>@Fa.Digits(a.Count.ToString())</small></a>
                }
            </div>
        </section>
    }

    <section class="section" aria-labelledby="latest-title">
        <div class="section-head">
            <h2 id="latest-title">تازه‌ترین آگهی‌ها</h2>
            <a class="more" href="@Taxonomy.Root">همهٔ آگهی‌ها @Icons.Get("chev-left", 18)</a>
        </div>
        @if (Model.Latest.Count == 0)
        {
            <div class="empty-state">@Icons.Get("home", 48)<h2>هنوز آگهی‌ای منتشر نشده</h2><p>به‌زودی آگهی‌های تازه اینجا قرار می‌گیرد.</p></div>
        }
        else
        {
            <div class="listings">@foreach (var p in Model.Latest) { <partial name="_PropertyCard" model="p" /> }</div>
        }
    </section>

<section class="section" aria-labelledby="how-title">
        <h2 id="how-title" class="title sr-only">چطور کار می‌کند</h2>
        <div class="steps">
            <div class="step"><span class="step-n">۱</span><h3>جست‌وجو کن</h3><p>با فیلتر شهر، نوع ملک، بودجه و تعداد خواب، فقط آگهی‌های مرتبط را ببین.</p></div>
            <div class="step"><span class="step-n">۲</span><h3>درخواست تماس بده</h3><p>نام و شماره‌ات را بگذار؛ مشاور برای هماهنگی بازدید با تو تماس می‌گیرد.</p></div>
            <div class="step"><span class="step-n">۳</span><h3>با خیال راحت معامله کن</h3><p>از بازدید تا قرارداد، مشاور کنارت است و مدارک را بررسی می‌کند.</p></div>
        </div>
    </section>

    <section class="section">
        <div class="cta-band">
            <div style="flex:1 1 420px;min-width:0">
                <h2>ملک داری؟ به ما بسپار</h2>
                <p>قیمت‌گذاری کارشناسی، عکاسی و انتشار هم‌زمان در سایت، کانال تلگرام و بله.</p>
            </div>
            <div class="row-actions">
                <a class="btn light lg" href="/تماس">درخواست مشاوره</a>
                <a class="btn outline-light lg" href="/املاک">دیدن آگهی‌ها</a>
            </div>
        </div>
    </section>

    <section class="section" id="faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="title" style="text-align:center;margin-bottom:20px">پرسش‌های متداول</h2>
        <div class="faq">
            @foreach (var f in faq) { <details><summary>@f.Q</summary><p>@f.A</p></details> }
        </div>
    </section>
</div>
