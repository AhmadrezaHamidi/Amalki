@page
@model IndexModel
@{ ViewData["Title"] = "خرید، فروش و اجارهٔ ملک"; }
<div class="wrap">
    <section class="hero">
        <h1>خانهٔ مناسبت را سریع و مطمئن پیدا کن</h1>
        <p>آگهی‌های خرید، رهن و اجارهٔ بررسی‌شده، با عکس واقعی و مشاور اختصاصی.</p>
    </section>
    <form class="search" method="get" action="/املاک" aria-label="جستجوی ملک">
        <select name="deal" aria-label="نوع معامله"><option value="Sale">خرید</option><option value="Rent">اجاره / رهن</option></select>
        <input name="city" placeholder="شهر (مثلاً تهران)" aria-label="شهر" />
        <select name="kind" aria-label="نوع ملک"><option value="">همهٔ انواع</option><option value="Apartment">آپارتمان</option><option value="Villa">ویلا</option><option value="Land">زمین</option><option value="Commercial">تجاری</option><option value="Office">اداری</option></select>
        <input name="maxPrice" inputmode="numeric" placeholder="سقف قیمت (تومان)" aria-label="سقف قیمت" />
        <button class="btn">جستجو</button>
    </form>
    <h2>جدیدترین آگهی‌ها <a href="/املاک">مشاهدهٔ همه ←</a></h2>
    <div class="grid">
        @foreach (var p in Model.Latest) { <partial name="_PropertyCard" model="p" /> }
    </div>
    @if (Model.Latest.Count == 0) { <p>هنوز آگهی‌ای منتشر نشده است.</p> }
</div>
