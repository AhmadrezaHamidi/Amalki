@page
@model Amlak.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "ورود مدیر"; ViewData["Robots"] = "noindex,nofollow"; }
<div class="wrap">
    <form method="post" class="auth form">
        <span class="brand-mark" style="align-self:center">@Icons.Get("home", 22)</span>
        <h1 style="text-align:center">ورود به پنل مدیریت</h1>
        <div asp-validation-summary="ModelOnly" class="err" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <label for="Email">ایمیل</label>
        <input asp-for="Email" autocomplete="username" dir="ltr" />
        <span asp-validation-for="Email" class="err"></span>
        <label for="Password">رمز عبور</label>
        <input asp-for="Password" autocomplete="current-password" dir="ltr" />
        <span asp-validation-for="Password" class="err"></span>
        <button class="btn lg block" style="margin-top:12px">ورود</button>
    </form>
</div>
